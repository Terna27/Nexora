{
  "name": "cryptiq-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Cryptiq — Institutional & Algorithmic Digital Asset Management Platform",
  "scripts": {
    "dev:web": "pnpm --filter @cryptiq/web dev",
    "dev:mobile": "pnpm --filter @cryptiq/mobile start",
    "build:web": "pnpm --filter @cryptiq/web build",
    "build:packages": "pnpm --filter \"@cryptiq/*\" build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r exec rm -rf node_modules dist .next .expo"
  },
  "devDependencies": {
    "puppeteer-core": "^25.18.1",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@12.23.0"
}
